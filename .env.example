# ---------- Database ----------
# Migrations/seed run as the schema OWNER (migrator). The API must use app_api.
MIGRATOR_DATABASE_URL=postgres://migrator:migrator@localhost:5432/whreg
APP_API_PASSWORD=app_api_dev_password
DATABASE_URL=postgres://app_api:app_api_dev_password@localhost:5432/whreg
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000099

# ---------- Auth ----------
JWT_SECRET=replace-with-64-random-bytes-base64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------- Object storage (S3 / Cloudflare R2 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=whreg-uploads
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# ---------- WhatsApp Business Cloud API ----------
WA_GRAPH_VERSION=v24.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # System-user permanent token
WA_APP_SECRET=              # for X-Hub-Signature-256 webhook verification
WA_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
WA_OWNER_NUMBERS=919800000001          # comma-separated, E.164 without '+'
WA_TEMPLATE_DISPATCH=dispatch_alert
WA_TEMPLATE_EOD=eod_digest
WA_TEMPLATE_LANG=en
WA_DRY_RUN=true             # log instead of sending (dev)

# ---------- Scheduling ----------
EOD_CRON=30 20 * * *        # 8:30 PM
EOD_TZ=Asia/Kolkata

# ---------- Mobile ----------
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
