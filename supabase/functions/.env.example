# Copy to supabase/functions/.env for `supabase functions serve` (never commit .env).
# In production set these with:  supabase secrets set --env-file supabase/functions/.env.production
RELAY_SECRET=change-me-long-random-string     # must equal Vault secret 'whatsapp_relay_secret'
LOGIN_EMAIL_DOMAIN=staff.whreg.app             # must equal EXPO_PUBLIC_LOGIN_EMAIL_DOMAIN in the app
WA_GRAPH_VERSION=v24.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_OWNER_NUMBERS=919800000001                  # comma-separated, E.164 without '+'
WA_TEMPLATE_DISPATCH=dispatch_alert
WA_TEMPLATE_EOD=eod_digest
WA_TEMPLATE_LANG=en
WA_DRY_RUN=true                                # false in production once templates are approved
