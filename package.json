{
  "name": "wh-reg",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "app": "pnpm --filter @wh/mobile start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "./supabase/tests/run.sh --supabase",
    "db:test:plain": "./supabase/tests/run.sh --plain",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "functions:test": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/tests",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  }
}
