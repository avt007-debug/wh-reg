{
  "expo": {
    "name": "WH Reg",
    "slug": "wh-reg",
    "scheme": "whreg",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Used to photograph lorry receipts and vendor invoices."
        }
      ]
    ],
    "android": {
      "package": "in.whreg.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "in.whreg.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    }
  }
}
