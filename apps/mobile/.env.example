# Supabase → Project Settings → API keys. The publishable key is safe in the app (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Must match LOGIN_EMAIL_DOMAIN in supabase/functions/.env
EXPO_PUBLIC_LOGIN_EMAIL_DOMAIN=staff.whreg.app
